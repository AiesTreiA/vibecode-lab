# ==============================================================================
# VIBECODE LAB · PLANTILLA DE VARIABLES DE ENTORNO (.env.example)
# ==============================================================================
# Instrucciones:
# 1. Duplica este archivo y renómbralo a '.env':
#    - Windows (PowerShell): cp .env.example .env
#    - Mac / Linux / Git Bash: cp .env.example .env
# 2. Reemplaza los valores de ejemplo con tus credenciales reales.
# 3. IMPORTANTE: NUNCA subas el archivo '.env' a GitHub ni lo compartas.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. INTELIGENCIA ARTIFICIAL & MODELOS (Google AI Studio)
# Consola: https://aistudio.google.com/app/apikey
# ------------------------------------------------------------------------------
GEMINI_API_KEY="AIzaSyTuClaveAquiDeGoogleAIStudio"

# (Opcionales para fases posteriores: DeepSeek / Anthropic)
# DEEPSEEK_API_KEY="sk-..."
# ANTHROPIC_API_KEY="sk-ant-..."


# ------------------------------------------------------------------------------
# 2. BASE DE DATOS & AUTENTICACIÓN (Supabase)
# Consola: https://supabase.com/dashboard/project/_/settings/api
# ------------------------------------------------------------------------------
# URL del proyecto (Project URL)
NEXT_PUBLIC_SUPABASE_URL="https://xyzcompany.supabase.co"

# Clave pública de cliente (anon / public key) - Segura para el navegador
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS..."

# Clave secreta administrativa (service_role) - ¡SOLO USO EN BACKEND / NUNCA EXPONER!
# SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."


# ------------------------------------------------------------------------------
# 3. CONFIGURACIÓN DEL SERVIDOR LOCAL & ENTORNO
# ------------------------------------------------------------------------------
NODE_ENV="development"
PORT=3000
APP_URL="http://localhost:3000"


# ------------------------------------------------------------------------------
# 4. ROADMAP DE FASES POSTERIORES (Clases 5 en adelante)
# Déjalos comentados por ahora; los configuraremos en el bloque de monetización.
# ------------------------------------------------------------------------------
# Mercado Pago: https://www.mercadopago.com/developers/panel/app
# MERCADO_PAGO_ACCESS_TOKEN="TEST-..."
# MERCADO_PAGO_PUBLIC_KEY="TEST-..."

# Resend / Correos: https://resend.com/api-keys
# RESEND_API_KEY="re_..."