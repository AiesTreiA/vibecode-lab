# ==========================================
# Vibecode Lab - Git Ignore Configuration
# Stack: Node.js / Next.js / Go / Supabase
# ==========================================

# ------------------------------------------
# Environment Variables & Secrets
# ------------------------------------------
.env
.env*.local
.env.development.local
.env.test.local
.env.production.local
*.pem

# IMPORTANTE: Forzar el seguimiento de .env.example para los alumnos
!.env.example

# ------------------------------------------
# Node.js & Package Managers
# ------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ------------------------------------------
# Next.js & Vercel
# ------------------------------------------
.next/
out/
build/
dist/
.vercel
.turbo

# ------------------------------------------
# Go (Golang)
# ------------------------------------------
*.exe
*.exe~
*.dll
*.so
*.dylib
bin/
main
app
*.test
*.out
coverage.txt

# ------------------------------------------
# Supabase & Database local
# ------------------------------------------
.supabase/
*.db
*.sqlite

# ------------------------------------------
# Logs & Temporales
# ------------------------------------------
logs
*.log
tmp/
.tmp/

# ------------------------------------------
# Sistema Operativo & Editores
# ------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# Editores / IDEs
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~
